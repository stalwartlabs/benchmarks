[Unit]
Description=mailbench sink MTA for relay tests
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/bench/bin/mailbench sink --listen 0.0.0.0:25
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
